{
  "name": "test-platforma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ustozlar uchun test platformasi (Vue 3 + Node.js)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
